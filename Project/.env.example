# Copia este archivo a Project/.env y ajusta los valores.
# Project/.env está en .gitignore: nunca se sube al repositorio.

# Genera una clave propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (usadas por Django y por docker-compose.yml)
POSTGRES_DB=gluteos
POSTGRES_USER=gluteos
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
